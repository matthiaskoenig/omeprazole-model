        </math>
      </assignmentRule>
      <assignmentRule name="renal excretion rate of the omeprazole metabolites" variable="OMEMETSEX">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <plus/>
            <ci> OMEOHEX </ci>
            <ci> OMEOTHEX </ci>
          </apply>
        </math>
      </assignmentRule>
    </listOfRules>
    <listOfReactions>
      <reaction metaid="meta_OMEOHEX" sboTerm="SBO:0000655" id="OMEOHEX" name="5-hydroxyomeprazole renal excretion" reversible="false" compartment="Vki">
        <annotation>
          <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:dcterms="http://purl.org/dc/terms/" xmlns:vCard="http://www.w3.org/2001/vcard-rdf/3.0#" xmlns:vCard4="http://www.w3.org/2006/vcard/ns#" xmlns:bqbiol="http://biomodels.net/biology-qualifiers/" xmlns:bqmodel="http://biomodels.net/model-qualifiers/">
            <rdf:Description rdf:about="#meta_OMEOHEX">
              <bqbiol:is>
                <rdf:Bag>
                  <rdf:li rdf:resource="https://identifiers.org/ncit:C75913"/>
                </rdf:Bag>
              </bqbiol:is>
            </rdf:Description>
          </rdf:RDF>
        </annotation>
        <listOfReactants>
          <speciesReference species="omeoh_ext" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="omeoh_urine" stoichiometry="1" constant="true"/>
        </listOfProducts>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:sbml="http://www.sbml.org/sbml/level3/version2/core">
            <apply>
              <times/>
              <ci> GFR </ci>
              <cn sbml:units="l_per_ml"> 0.001 </cn>
              <ci> OMEOHEX_f </ci>
              <ci> omeoh_ext </ci>
            </apply>
          </math>
